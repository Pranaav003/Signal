# Fly.io backend environment variables
# Set with: fly secrets set KEY=VALUE

DATABASE_URL=postgres://user:pass@host:5432/signal
OPENAI_API_KEY=sk-...
FRONTEND_URL=https://your-app.pages.dev
CORS_EXTRA_ORIGINS=

# Optional: proxy for Reddit scraping
PROXY_LIST=
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: scheduler tuning
SCHEDULER_POLL_INTERVAL_MS=30000
MAX_CONCURRENT_SCANS=2
